# Block PHP execution in uploads folder
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|phar)$">
    Require all denied
</FilesMatch>

# Block other executable types
<FilesMatch "\.(pl|py|cgi|sh|bash)$">
    Require all denied
</FilesMatch>

# Disable PHP engine and CGI execution
Options -ExecCGI
php_flag engine off