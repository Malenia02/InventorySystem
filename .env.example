APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/inventory_system
APP_TIMEZONE=Asia/Manila
APP_PUBLIC_DEMO=false
APP_ENABLE_PUBLIC_INSTALLER=false
APP_ALLOW_RUNTIME_SCHEMA_CHANGES=false
APP_KEY=base64:generate_a_32_byte_random_key
WS_SHARED_SECRET=generate_a_32_byte_random_secret
BACKUP_SIGNING_KEY=generate_a_32_byte_random_secret
APP_SECURE_STORAGE_DIR=C:/xampp/secure

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

SESSION_TIMEOUT=1800
